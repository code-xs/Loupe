<task id="mobile-qa/ui-deep-dive/workflow.xml" name="UI Deep-Dive Workflow Orchestrator">
    <llm critical="true">
        <mandate>务必严格按照 U1 到 U4 顺序执行</mandate>
        <mandate>输出最小可运行的 UI 专项 RCA 与摘要</mandate>
    </llm>
    <flow>
        <step n="1" goal="加载流程规范与状态模板">
            <load target="mobile-qa-workflow/core/core-rules.xml" prompt="重新加载作为流程规范，并严格遵守"/>
            <check if="{workflow_status} 文件不存在">
                <load target="mobile-qa-workflow/ui-deep-dive/core/workflow-status-template.yaml" prompt="内容作为模版，创建 {workflow_status} 文件"/>
            </check>
            <action>更新 {workflow_status}：current_state = DD-InProgress</action>
        </step>
        <step n="2" goal="执行 UI Deep-Dive 阶段">
            <load target="mobile-qa-workflow/ui-deep-dive/phases/u1-context-and-visual-baseline.md" prompt="加载并执行，传递 workspace_folder、config_source、issue_card、spec_file、context_bundle"/>
            <load target="mobile-qa-workflow/ui-deep-dive/phases/u2-layout-topology.md" prompt="加载并执行，传递 workspace_folder、config_source、spec_file、context_bundle"/>
            <load target="mobile-qa-workflow/ui-deep-dive/phases/u3-render-timing-and-interaction.md" prompt="加载并执行，传递 workspace_folder、config_source、spec_file、context_bundle"/>
            <load target="mobile-qa-workflow/ui-deep-dive/phases/u4-ui-ruling.md" prompt="加载并执行，传递 workspace_folder、config_source、issue_card、spec_file、context_bundle"/>
        </step>
        <step n="3" goal="完成并回注状态">
            <action>更新 {workflow_status}：current_state = DD-Completed, lastStep = u4-ui-ruling</action>
        </step>
    </flow>
</task>
